    helper = osxkeychain
[user]
    name = Josh Quintus
    email = josh@dirtlabs.ai
[alias]
    unstage = reset HEAD --
    unadd = reset
    unstash = stash pop
    kev  = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard   # Move your current changes to the Recycle bin (instead of just burning it down). You can use git reflog to find the commit again and restore it if need be.  http://haacked.com/archive/2014/07/28/github-flow-aliases/
    super-kev = !git fetch origin && git reset --hard origin/$(git symbolic-ref --short HEAD) && git clean -fd
    ec = config --global -e                                                            # Edit this file http://haacked.com/archive/2014/07/28/github-flow-aliases/
    co = checkout                                                                      # Checkout
    cob = checkout -b                                                                  # Checkout a new branch
    amend  = checkout --amend

    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    la = "!git config -l | grep alias | cut -c 7-"                                     # List aliases

    branches = branch -l                                                               # List branches
    pushup = "!git push --set-upstream origin $(git symbolic-ref --short HEAD)"        # Set the upstream

    pb = remote prune origin 

    vim = "!git diff --name-only | xargs gvim -p"                                      # Open all edited files in vim (the -p tells vim to open each file in a new tab)
    vimHead = "!git diff-tree --no-commit-id --name-only -r HEAD | xargs gvim -p"      # Open all the files from the last commit in vim
    vimDiff = "!gvim -p -c 'tabdo Gdiff' $(git status --porcelain | awk '{print $2}')" # Open all edited files in vim in diff view

    sortBranchesByCommitDate = "branch --sort=-committerdate -l 'jq*'"
	aliases = !nvim ~/.gitconfig
	merge-default-into = "!f() {\n  branch=\"$1\"\n  [ -n \"$branch\" ] || { echo \"usage: git merge-default-into <branch>\" >&2; return 1; }\n  dir=\"/tmp/git-merge-$branch-$$\"\n\n  git fetch origin || return 1\n\n  # merge whatever the remote calls default, so a master -> main rename is a no-op here\n  default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD)\n  if [ -z \"$default\" ]; then\n    git remote set-head origin -a >/dev/null 2>&1\n    default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD)\n  fi\n  [ -n \"$default\" ] || { echo \"merge-default-into: cannot resolve origin/HEAD\" >&2; return 1; }\n\n  # create worktree directly from remote branch\n  git worktree add -f \"$dir\" -b \"$branch-tmp-$$\" \"origin/$branch\" || return 1\n\n  (\n    cd \"$dir\" &&\n    git merge --no-edit \"$default\" &&\n    git push origin HEAD:\"$branch\"\n  )\n\n  status=$?\n  git worktree remove \"$dir\"\n  git branch -D \"$branch-tmp-$$\" 2>/dev/null\n  return $status\n}; f"
	merge-master-into = "!git merge-default-into"

    force-build = commit --allow-empty -m 'force a build'
    kick-build = commit --allow-empty -m 'force a build'

[grep]
    lineNumber = true

[web]
    browser = google-chrome

[diff]
    tool = vimdiff

[core]
    editor = nvim
	excludesfile = /Users/jq/.gitignore
	pager = delta                      # was `less -R`; delta shells out to less itself
[interactive]
	diffFilter = delta --color-only    # colours `git add -p` the same way
[delta]
	navigate = true                    # n / N jump between files in the diff
	line-numbers = true                # old and new line numbers in a gutter
	# side-by-side = true              # uncomment for two columns; wants a wide window
[pager]
	branch = false
[color]
	ui = auto
[fetch]
	prune = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
