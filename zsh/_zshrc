# Make # comments in the shell
setopt interactive_comments

# A bare directory name means cd into it. Saves the `cd` on the paths typed
# most often, and is harmless otherwise: it only fires when the word is not a
# command and does name a directory.
setopt AUTO_CD

# Sort globs numerically, so file2 comes before file10 rather than after it.
setopt NUMERIC_GLOB_SORT

# Every cd pushes onto the directory stack, so `back` (popd) works after any
# move, not only after the aliases that called pushd explicitly. This is also
# what makes AUTO_CD a full replacement for `alias ..='pushd ..'`: without it,
# a bare `..` would change directory without leaving anything to pop back to.
#   PUSHD_IGNORE_DUPS  don't stack the same directory twice
#   PUSHD_SILENT       don't print the whole stack after every cd
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT

GIT_PS1_SHOWDIRTYSTATE=true

