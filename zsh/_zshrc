########################################
# Completion behaviour.
########################################
# Match case-insensitively, so `cd dow<Tab>` finds Downloads. Lowercase input
# matches either case; typing an explicit capital still requires one.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Colour completion matches the way `ls` colours a listing. macOS ships BSD ls,
# which reads LSCOLORS and leaves LS_COLORS empty, so the usual one-liner for
# this silently does nothing here. gdircolors (GNU coreutils, already in the
# Brewfile) generates a real LS_COLORS, which zsh's completion system and eza
# both understand.
if command -v gdircolors >/dev/null 2>&1; then
  eval "$(gdircolors -b)"
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
fi
[ -f /Users/jq/.claude/hooks/peon-ping/completions.bash ] && source /Users/jq/.claude/hooks/peon-ping/completions.bash
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

########################################
# History: bigger, deduped, shared across sessions, timestamped.
########################################
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY        # record command timestamp + duration
setopt SHARE_HISTORY           # share history live across all open sessions
setopt HIST_IGNORE_ALL_DUPS    # drop older duplicates of a command
setopt HIST_IGNORE_SPACE       # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS      # trim superfluous whitespace before saving
setopt HIST_VERIFY             # let me edit a !history expansion before it runs
setopt HIST_FIND_NO_DUPS       # skip dupes when cycling through searches

########################################
# fzf: fuzzy Ctrl-R history search (also Ctrl-T files, Alt-C cd).
########################################
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]   && source /opt/homebrew/opt/fzf/shell/completion.zsh

# Ctrl-T picks a file, but with no preview you are choosing off the filename
# alone. bat fills the pane with syntax-highlighted, line-numbered content.
#
# Ctrl-T's list includes directories and bat only reads files, so directories
# get their own branch: a two-level eza tree, because when the highlighted entry
# is a directory the useful question is what's inside it, not its permission
# bits. Icons come from the Meslo Nerd Font the Brewfile already installs.
#
# Both branches are capped (200 lines, 2 levels) because the preview re-renders
# on every keystroke and one stray node_modules would otherwise stall it.
#
# Falls back to `ls` when eza is missing, and skips the whole block when bat is
# missing, so a machine without either still gets a working Ctrl-T.
#
# Deliberately scoped to the picker: bat is NOT aliased over cat, which was
# tried and disliked. eza is on trial here for the same reason, as a
# low-commitment place to find out whether its output is actually preferred.
# See TODO.md.
#
# Ctrl-/ toggles the preview pane off when the file list itself is what matters.
# Some terminals don't deliver that chord; it is a convenience, not load-bearing.
# What Ctrl-T lists: the current directory, one level deep, nothing else.
#
# This is a deliberate choice, so do not "fix" it back to a recursive walk.
# fzf's default walks the entire tree below the cwd, which in ~/code is 142k
# entries; scoping that to files git would track still left 6.7k. Both turn
# Ctrl-T into a haystack. What is actually wanted is a listing of where you
# already are, with previews, and a `cd` first when the target is elsewhere.
#
# Directories are included, which is what makes the eza branch below worth
# having. Hidden files are in, .git and .DS_Store are out.
#
# `ls -p` appends a slash to directories and nothing else (unlike -F, which also
# tags executables and symlinks and would corrupt the inserted path). The slash
# distinguishes the two kinds at a glance and is what you want when the picked
# path is the start of a longer one.
export FZF_CTRL_T_COMMAND="ls -A -p | grep -v -e '^\.git/$' -e '^\.DS_Store$'"

# Alt-C gets the same treatment for the same reason: fzf's default walks every
# directory below the cwd, which is 16k entries in ~/code. Directories only, one
# level deep. Reaching somewhere far away is a separate problem, and one that
# has not actually come up in practice, so it is not solved here.
export FZF_ALT_C_COMMAND="ls -A -p | grep '/$' | grep -v '^\.git/$'"

if command -v bat >/dev/null 2>&1; then
  if command -v eza >/dev/null 2>&1; then
    _fzf_dir_preview='eza --tree --level=2 --color=always --icons=always {} | head -200'
  else
    _fzf_dir_preview='ls -FGlAhp {}'
  fi
  export FZF_CTRL_T_OPTS="
    --preview 'if [ -d {} ]; then $_fzf_dir_preview; else bat --color=always --style=numbers --line-range=:200 {}; fi'
    --preview-window=right,60%,border-left
    --bind=ctrl-/:toggle-preview"
  unset _fzf_dir_preview
fi

# Alt-C previews the directory it is about to cd into. Ctrl-T lists files only
# now, so this is where the eza tree earns its keep, and seeing a directory's
# contents before entering it is the whole question Alt-C is answering anyway.
if command -v eza >/dev/null 2>&1; then
  export FZF_ALT_C_OPTS="
    --preview 'eza --tree --level=2 --color=always --icons=always {} | head -200'
    --preview-window=right,60%,border-left"
fi

########################################
# history-substring-search: type a prefix, then ↑/↓ to cycle matching commands.
########################################
if [ -f /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
  source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
  zmodload zsh/terminfo 2>/dev/null
  bindkey '^[[A' history-substring-search-up      # up arrow
  bindkey '^[[B' history-substring-search-down    # down arrow
  [[ -n "$terminfo[kcuu1]" ]] && bindkey "$terminfo[kcuu1]" history-substring-search-up    # up (application mode)
  [[ -n "$terminfo[kcud1]" ]] && bindkey "$terminfo[kcud1]" history-substring-search-down  # down (application mode)
fi

########################################
# insert-last-word: Esc-.  (also Alt-. if your terminal sends Option as Meta).
# Repeat to walk back through earlier commands — the classic bash trick.
########################################
bindkey '^[.' insert-last-word

########################################
# Line editing: escape hatches for commands that outgrow a single line.
########################################
# Ctrl-X Ctrl-E opens the current command in $EDITOR. Save and quit to run it.
# The escape hatch for anything with quoting, loops, or a pipeline long enough
# that editing it in place is worse than editing it in nvim.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Ctrl-_ undoes the last edit to the line. Stock zsh widget, but not bound by
# default in this setup, so a mangled line otherwise means retyping it.
bindkey '^_' undo

# Ctrl-W deletes back to the previous word. zsh's default WORDCHARS counts `/`
# as part of a word, so one press eats a whole path; dropping it (and `=`) makes
# Ctrl-W walk back a path one segment at a time, and a flag one at a time.
WORDCHARS='*?_-.[]~&;!#$%^(){}<>'

# Space expands !! and !$ in place instead of at execution, so history
# expansions can be seen and edited before running. Pairs with HIST_VERIFY.
bindkey ' ' magic-space

########################################
# Per-host config: source zsh/_zshrc-<hostname> if it exists.
# Use scutil LocalHostName on macOS — `hostname` reflects the transient DHCP
# name and drifts with the network; LocalHostName is the stable machine name.
########################################
# Absolute path + zsh's built-in $HOST so this never depends on PATH being
# fully set up (a `source ~/.zshrc` reload skips /etc/zprofile's path_helper).
_host=$(/usr/sbin/scutil --get LocalHostName 2>/dev/null || echo ${HOST%%.*})
_host_zshrc=~/dotfiles/zsh/_zshrc-$_host
[[ -f "$_host_zshrc" ]] && source "$_host_zshrc"
unset _host_zshrc _host

########################################
# config: open/reload shell config files (convention: zsh/_zshrc-<name>)
#   config            fzf picker over all config files
#   config dirty      edit zsh/_zshrc-dirty   (this host's config)
#   config aliases    edit zsh/_zshrc-aliases
#   config zshrc      edit the base rc
#   config db         edit ~/.config/zsh/db.local.zsh (local DB connections)
#   config -reload    fresh login shell (exec zsh -l), same as `rl`
# Defined after compinit so `compdef` is available for completion.
########################################
config() {
  local zdir=~/dotfiles/zsh
  case "$1" in
    -reload|--reload|reload)
      exec zsh -l ;;
    "")
      local pick
      pick=$( { command ls -d "$zdir"/_zshrc* 2>/dev/null | grep -v zwc
        [[ -f ~/.config/zsh/db.local.zsh ]] && echo ~/.config/zsh/db.local.zsh; } |
        fzf --prompt='config ❯ ' --height=40% --reverse) &&
        "${EDITOR:-nvim}" "$pick" ;;
    zshrc|rc)
      "${EDITOR:-nvim}" "$zdir/_zshrc" ;;
    db)
      "${EDITOR:-nvim}" ~/.config/zsh/db.local.zsh ;;
    *)
      local f="$zdir/_zshrc-$1"
      if [[ -f "$f" ]]; then
        "${EDITOR:-nvim}" "$f"
      else
        print -u2 "config: no config named '$1'  ($f)"
        print -u2 "try: config           (picker)   |   config -reload"
        return 1
      fi ;;
  esac
}

_config() {
  local zdir=~/dotfiles/zsh
  local -a names
  names=(${(f)"$(command ls "$zdir" | grep -E '^_zshrc' | grep -v zwc |
    sed -E 's/^_zshrc-//; s/^_zshrc$/zshrc/')"})
  compadd -- reload db $names
}
compdef _config config

########################################
# Fast reload: `rl`, Ctrl-X Ctrl-R, and `config -reload` are all identical.
# `exec zsh -l` replaces this shell with a fresh login shell, exactly like
# opening a new tab: re-runs /etc/zprofile (path_helper) so the system PATH is
# restored, and typeset -U keeps it deduped. Trade-off: background jobs and any
# interactively-defined vars/functions in this shell are discarded.
########################################
alias rl='exec zsh -l'
_reload_shell() { BUFFER='exec zsh -l'; zle accept-line }
zle -N _reload_shell
bindkey '^X^R' _reload_shell

########################################
# Starship prompt (config: ~/.config/starship.toml -> dotfiles/starship.toml)
########################################
command -v starship >/dev/null && eval "$(starship init zsh)"

