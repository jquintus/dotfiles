#!/usr/bin/env bash

###############################################################################
# Script Name: claude-cloud
# Description: Hands a plain-English task to a Claude Code cloud session, which
#              keeps working after the laptop is shut, and saves the teleport
#              line for picking it up in the morning.
#
#              The prompt goes to `--cloud` rather than being positional.
#              `--cloud` is documented as taking an optional value, but it
#              refuses to run without one ("--cloud requires a description"),
#              and that description is what the session works on.
#
#              `--cloud` creates the session and exits rather than attaching,
#              printing a "Resume with: claude --teleport <id>" line. That line
#              scrolls away by morning, so this captures it and keeps the id in
#              ~/.claude/last-cloud-session.
#
#              Capturing has to go through `script`, not a pipe. `--cloud`
#              refuses to run when stdout is not a terminal ("Non-interactive
#              invocations ... run locally and would silently ignore --cloud"),
#              so a plain `| tee` kills the very thing being run. `script` hands
#              claude a pty, echoes to the terminal, and writes the same bytes
#              to a file. It also gives stdin a pty, which is what lets a brief
#              be piped in.
#
#              Josh is on a DirtLabs Team seat with no GitHub connection for
#              Claude Code on the web, so sessions started from the browser have
#              no repos to choose from. Started from here they upload the local
#              checkout instead, which is why this is the working path.
#
# Author: Josh Quintus
# Usage:
#   claude-cloud figure out how to build a flux capacitor
#   claude-cloud fix the flaky tests in src/api -- --model opus
#   claude-cloud < overnight-brief.md
# Date: August 2026
###############################################################################

set -euo pipefail

LAST_SESSION_FILE="$HOME/.claude/last-cloud-session"

# Everything up to a bare `--` is the prompt; anything after it is passed
# through to claude untouched.
prompt_words=()
passthrough=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
        shift
        passthrough=("$@")
        break
    fi
    prompt_words+=("$1")
    shift
done

prompt="${prompt_words[*]-}"

# No prompt on the command line means it is being piped in, which is the
# comfortable way to hand over a long overnight brief.
if [[ -z "$prompt" ]]; then
    if [[ -t 0 ]]; then
        echo "claude-cloud: give me a prompt, or pipe one in" >&2
        echo "usage: claude-cloud figure out how to build a flux capacitor" >&2
        exit 1
    fi
    prompt="$(cat)"
fi

if [[ -z "${prompt//[[:space:]]/}" ]]; then
    echo "claude-cloud: the prompt is empty" >&2
    exit 1
fi

log="$(mktemp -t claude-cloud)"
trap 'rm -f "$log"' EXIT

# `script` needs a terminal on its own stdin before it can hand one to a child,
# so probe with a throwaway run rather than discovering it on the real one.
# Reading from /dev/tty keeps that true even when a brief was piped in.
# /dev/tty can exist as a device node and still not be openable, so test by
# opening it rather than by asking what kind of file it is.
use_script=0
if command -v script >/dev/null 2>&1 && { : < /dev/tty; } 2>/dev/null; then
    if script -q /dev/null true < /dev/tty > /dev/null 2>&1; then
        use_script=1
    fi
fi

# Claude's own "Resume with:" line is the one this script reprints properly at
# the end, and the git-config warning is a fact about this checkout rather than
# about the session. Everything else passes through, errors included -- a
# deny-list keeps a failed run visible in a way an allow-list would not.
# Piping here is safe: the child's terminal comes from script's pty, not from
# script's stdout.
NOISE='^(Resume with:|This checkout reads git configuration)'

set +e
if [[ $use_script -eq 1 ]]; then
    script -q "$log" claude --cloud "$prompt" \
        --permission-mode acceptEdits \
        ${passthrough[@]+"${passthrough[@]}"} < /dev/tty \
        | tr -d '\r' | grep -avE --line-buffered "$NOISE"
    status=${PIPESTATUS[0]}
else
    # No pty available: run it straight so the session still starts, and let
    # Josh copy the teleport line off the screen himself.
    claude --cloud "$prompt" \
        --permission-mode acceptEdits \
        ${passthrough[@]+"${passthrough[@]}"}
    status=$?
fi
set -e

id="$(grep -o 'session_[A-Za-z0-9]\{6,\}' "$log" | head -1 || true)"

echo
if [[ -n "$id" ]]; then
    printf '%s\n' "claude --teleport $id" > "$LAST_SESSION_FILE"
    echo "In the morning:"
    echo
    echo "    claude --teleport $id"
else
    echo "claude-cloud: no session id to save."
    echo "If a session did start, it is at https://claude.ai/code"
fi

exit "$status"
