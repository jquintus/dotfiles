#!/bin/bash

# codex-sync — give Codex the same subagents, skills and global instructions
# that Claude Code already has.
#
# Codex reads a different shape of config than Claude Code, so this cannot be
# plain symlinks the way scripts/links.manifest does it:
#
#   ~/.codex/AGENTS.md        generated  <- claude/CLAUDE.md (+ its @-imports)
#   ~/.codex/agents/*.toml    generated  <- claude/agents/*.md
#   ~/.codex/skills/<name>    symlink    -> ~/.claude/skills/<name>
#
# Skills are the same SKILL.md format in both tools, so those are real symlinks
# and edits flow both ways. The other two are generated: rerun this after
# editing CLAUDE.md or anything in claude/agents/. scripts/install-mac.sh runs
# it, so a fresh machine gets it for free.
#
# Only ever touches files it generated (they carry a marker line) or symlinks it
# owns (they point into ~/.claude). Anything else in ~/.codex is left alone.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
CLAUDE_HOME="$HOME/.claude"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
MARKER="# Generated by codex-sync from ~/dotfiles. Do not edit; edit the source and rerun."

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }

mkdir -p "$CODEX_HOME/agents" "$CODEX_HOME/skills"

########################################
# 1. Global instructions: CLAUDE.md -> AGENTS.md
########################################
# Codex has no @-import, so the machine-local work file that CLAUDE.md pulls in
# gets inlined here instead. That keeps work-specific content out of the public
# dotfiles repo while still reaching Codex.
expand_imports() {
    local line inc
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^@([^[:space:]]+)[[:space:]]*$ ]]; then
            inc="${BASH_REMATCH[1]/#\~/$HOME}"
            if [[ -f "$inc" ]]; then
                printf '\n'
                cat "$inc"
                printf '\n'
                continue
            fi
        fi
        printf '%s\n' "$line"
    done < "$1"
}

# CLAUDE.md carries maintainer notes in block-level HTML comments, which Claude
# strips before injecting the file. Codex does not, so strip them here.
strip_html_comments() {
    awk '
        /^[[:space:]]*<!--/ { inc = 1 }
        inc { if ($0 ~ /-->[[:space:]]*$/) inc = 0; next }
        { print }
    ' | cat -s
}

write_agents_md() {
    local src="$DOTFILES_ROOT/claude/CLAUDE.md"
    if [[ ! -f "$src" ]]; then
        warn "No claude/CLAUDE.md; skipping ~/.codex/AGENTS.md"
        return
    fi
    {
        echo "$MARKER"
        echo "# Source: claude/CLAUDE.md"
        echo
        echo "These are the same standing instructions Claude Code runs under. Where they"
        echo "name a Claude-only mechanism, use the Codex equivalent: the Agent tool means"
        echo "Codex subagents (defined in ~/.codex/agents/*.toml), and Claude model names"
        echo "(opus/sonnet/haiku) mean the closest Codex model by capability."
        echo
        expand_imports "$src" | strip_html_comments
    } > "$CODEX_HOME/AGENTS.md"
    info "Wrote $CODEX_HOME/AGENTS.md"
}

########################################
# 2. Subagents: claude/agents/*.md -> ~/.codex/agents/*.toml
########################################
# A Claude subagent is YAML frontmatter plus a markdown body. A Codex custom
# agent is a TOML file requiring name, description and developer_instructions.
# The body goes in verbatim as a TOML multi-line literal string, so nothing in
# it needs escaping.
frontmatter_value() {
    awk -v key="$2" '
        /^---[[:space:]]*$/ { n++; if (n == 2) exit; next }
        n == 1 && index($0, key ":") == 1 {
            print substr($0, length(key) + 2)
            exit
        }
    ' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

agent_body() {
    awk '/^---[[:space:]]*$/ { n++; if (n <= 2) next } n >= 2' "$1" \
        | sed -e '/./,$!d'
}

toml_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

write_agents() {
    local src name desc tools body out
    local -a generated=()

    for src in "$DOTFILES_ROOT"/claude/agents/*.md; do
        [[ -f "$src" ]] || continue
        name="$(frontmatter_value "$src" name)"
        desc="$(frontmatter_value "$src" description)"
        tools="$(frontmatter_value "$src" tools)"
        if [[ -z "$name" || -z "$desc" ]]; then
            warn "$(basename "$src") has no name/description in its frontmatter; skipping"
            continue
        fi
        body="$(agent_body "$src")"
        if [[ "$body" == *"'''"* ]]; then
            warn "$name contains ''' and cannot be embedded in TOML; skipping"
            continue
        fi

        out="$CODEX_HOME/agents/$name.toml"
        {
            echo "$MARKER"
            echo "# Source: claude/agents/$(basename "$src")"
            echo
            echo "name = \"$(toml_escape "$name")\""
            echo "description = \"$(toml_escape "$desc")\""
            # Claude's per-agent tool allowlist has no Codex equivalent, and
            # sandbox_mode is not one: Codex read-only also blocks the network
            # and makes every command ask for approval, which would break an
            # agent that reads code AND runs scanners. Recorded as a comment so
            # the difference is visible, and left to the agent's own
            # instructions to enforce the way Claude's prompt already does.
            if [[ -n "$tools" ]]; then
                echo "# Claude grants this agent: $tools"
            fi
            echo
            echo "developer_instructions = '''"
            printf '%s\n' "$body"
            echo "'''"
        } > "$out"
        generated+=("$out")
        info "Wrote $out"
    done

    # Drop agents we generated on a previous run whose source is gone.
    local existing keep
    for existing in "$CODEX_HOME"/agents/*.toml; do
        [[ -f "$existing" ]] || continue
        head -n1 "$existing" | grep -qF 'Generated by codex-sync' || continue
        keep=""
        for out in ${generated[@]+"${generated[@]}"}; do
            [[ "$out" == "$existing" ]] && keep=1 && break
        done
        if [[ -z "$keep" ]]; then
            rm -f "$existing"
            info "Removed stale $existing"
        fi
    done
}

########################################
# 3. Skills: symlink every skill Claude has
########################################
# Deliberately sourced from ~/.claude/skills rather than the repo, so Codex sees
# the skills installed on this machine too, not just the tracked ones.
write_skills() {
    local dir name target
    if [[ ! -d "$CLAUDE_HOME/skills" ]]; then
        warn "No $CLAUDE_HOME/skills; skipping skills"
        return
    fi

    for dir in "$CLAUDE_HOME"/skills/*/; do
        [[ -d "$dir" ]] || continue
        name="$(basename "$dir")"
        target="$CODEX_HOME/skills/$name"
        if [[ -e "$target" && ! -L "$target" ]]; then
            warn "$target is a real directory, not ours; leaving it alone"
            continue
        fi
        ln -nfs "${dir%/}" "$target"
        info "Linked skill $name"
    done

    # Drop links to skills that have since been uninstalled from Claude.
    for target in "$CODEX_HOME"/skills/*; do
        [[ -L "$target" ]] || continue
        case "$(readlink "$target")" in
            "$CLAUDE_HOME"/skills/*)
                if [[ ! -d "$target" ]]; then
                    rm -f "$target"
                    info "Removed stale skill link $(basename "$target")"
                fi
                ;;
        esac
    done
}

########################################
# 4. config.toml: teach Codex to read CLAUDE.md as instructions
########################################
# Per-repo CLAUDE.md files are invisible to Codex unless listed as a fallback.
# Codex takes at most one instruction file per directory and prefers AGENTS.md,
# so this only kicks in where a repo has a CLAUDE.md and no AGENTS.md.
#
# Written once, never rewritten: peon-ping owns its own block in this file and
# Codex itself writes here when you change models. It goes at the TOP, because a
# bare key appended to the end of a TOML file lands inside whichever table
# header came last -- here it would have become a peon-ping hook setting.
write_config() {
    local cfg="$CODEX_HOME/config.toml"
    touch "$cfg"
    if grep -q '^project_doc_fallback_filenames' "$cfg"; then
        return
    fi
    local tmp
    tmp="$(mktemp -t codex-config)"
    {
        echo "# Added by codex-sync: read a repo's CLAUDE.md when it has no AGENTS.md."
        echo 'project_doc_fallback_filenames = ["CLAUDE.md"]'
        echo
        cat "$cfg"
    } > "$tmp"
    mv "$tmp" "$cfg"
    info "Added project_doc_fallback_filenames to $cfg"
}

write_agents_md
write_agents
write_skills
write_config

info "Codex synced. Sign in once with 'codex login' if you have not already."
