#!/usr/bin/env bash
# Markdown processor for VimR's preview pane.
#
# VimR's built-in preview has two problems this fixes:
#
#   1. It renders with plain cmark, so GFM tables, task lists, strikethrough
#      and bare autolinks come out as literal punctuation.
#   2. Its template loads Prism's light theme, whose `text-shadow: 0 1px #fff`
#      halos every glyph, and its color-overrides.css repaints the page with
#      colors sampled from the nvim theme -- which is how you end up with a
#      white page wrapping near-black code blocks. The bundled
#      github-markdown.css is already light/dark aware on its own, so the fix
#      is to point the nvim variables back at that stylesheet's own tokens
#      rather than pick a third palette.
#
# Set the path to this script in
# VimR -> Preferences -> Tools -> Markdown -> "Custom Markdown Processor".
# VimR then uses this output as the preview body. --sourcepos is kept so the
# two-way scroll sync between editor and preview keeps working.
#
# Reads markdown from the first argument if it is a readable file, otherwise
# from stdin, and prints HTML to stdout.

set -euo pipefail

CMARK=${VIMR_MD_CMARK:-$(command -v cmark-gfm || echo /opt/homebrew/bin/cmark-gfm)}

if [[ ! -x $CMARK ]]; then
  printf '<pre>vimr-md: cmark-gfm not found. brew install cmark-gfm</pre>\n'
  exit 0
fi

cat <<'CSS'
<style>
/* VimR samples these from the running nvim theme and applies them last, which
   is what desynchronizes the page from its code blocks. Feeding them
   github-markdown.css's own tokens puts the whole preview back on one palette
   and lets it follow the system light/dark setting. Declared on
   .markdown-body because that is the element the --color-* tokens live on. */
body.markdown-body {
  --nvim-color: var(--color-fg-default);
  --nvim-background-color: var(--color-canvas-default);
  --nvim-link-color: var(--color-accent-fg);
  --nvim-hr-color: var(--color-border-default);
  --nvim-blockquote-border-color: var(--color-border-default);
  --nvim-blockquote-color: var(--color-fg-muted);
  --nvim-h2-border-color: var(--color-border-muted);
  --nvim-h6-color: var(--color-fg-muted);
  --nvim-code-background-color: var(--color-canvas-subtle);
  --nvim-code-color: var(--color-fg-default);

  --nvim-comment-color: var(--color-prettylights-syntax-comment);
  --nvim-string-color: var(--color-prettylights-syntax-string);
  --nvim-boolean-color: var(--color-prettylights-syntax-constant);
  --nvim-number-color: var(--color-prettylights-syntax-constant);
  --nvim-statement-color: var(--color-prettylights-syntax-keyword);
  --nvim-type-color: var(--color-prettylights-syntax-entity);
  --nvim-constant-color: var(--color-prettylights-syntax-constant);
  --nvim-special-color: var(--color-fg-muted);

  --md-mono: "MesloLGS Nerd Font Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
}

/* A measure and some margin, instead of text flush against the pane edges. */
body.markdown-body {
  max-width: 46rem;
  margin: 0 auto;
  padding: 2rem 1.75rem 6rem;
  font-size: 15px;
  line-height: 1.65;
}

/* Prism's stock theme paints a white text-shadow to suit its own light
   background. Over any other background that halo is the smearing. */
code[class*="language-"],
pre[class*="language-"],
code[class*="language-"] *,
pre[class*="language-"] * {
  text-shadow: none !important;
}

/* Prism hard-codes `color: #000` on the code element itself and paints a
   translucent white block behind operators, both of which assume its own light
   background. Repoint everything it colors at github-markdown.css's syntax
   tokens so highlighting follows the same theme as the page. */
.markdown-body code[class*="language-"],
.markdown-body pre[class*="language-"],
.markdown-body pre > code {
  color: var(--color-fg-default);
  background: none;
}

.markdown-body .token.operator,
.markdown-body .token.entity,
.markdown-body .token.url,
.markdown-body .language-css .token.string,
.markdown-body .style .token.string {
  background: none;
}

.markdown-body .token.comment,
.markdown-body .token.prolog,
.markdown-body .token.doctype,
.markdown-body .token.cdata { color: var(--color-prettylights-syntax-comment); }

.markdown-body .token.punctuation,
.markdown-body .token.operator { color: var(--color-fg-muted); }

.markdown-body .token.boolean,
.markdown-body .token.number,
.markdown-body .token.constant,
.markdown-body .token.symbol,
.markdown-body .token.property { color: var(--color-prettylights-syntax-constant); }

.markdown-body .token.selector,
.markdown-body .token.attr-name,
.markdown-body .token.string,
.markdown-body .token.char,
.markdown-body .token.builtin,
.markdown-body .token.inserted { color: var(--color-prettylights-syntax-string); }

.markdown-body .token.atrule,
.markdown-body .token.attr-value,
.markdown-body .token.keyword { color: var(--color-prettylights-syntax-keyword); }

.markdown-body .token.function,
.markdown-body .token.class-name { color: var(--color-prettylights-syntax-entity); }

.markdown-body .token.tag,
.markdown-body .token.deleted { color: var(--color-prettylights-syntax-entity-tag); }

.markdown-body .token.regex,
.markdown-body .token.important,
.markdown-body .token.variable { color: var(--color-prettylights-syntax-variable); }

/* Match the editor's font rather than Prism's Consolas/Monaco fallback. */
code[class*="language-"],
pre[class*="language-"],
.markdown-body code,
.markdown-body pre,
.markdown-body pre > code,
.markdown-body kbd,
.markdown-body samp,
.markdown-body tt {
  font-family: var(--md-mono);
}

/* Long shell one-liners wrap instead of running off the right edge. */
.markdown-body pre,
.markdown-body pre > code,
pre[class*="language-"],
code[class*="language-"] {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: normal;
  tab-size: 2;
}

.markdown-body pre {
  border: 1px solid var(--color-border-default);
  border-radius: 6px;
  padding: 0.85rem 1rem;
  font-size: 0.85em;
  line-height: 1.55;
}

.markdown-body pre > code {
  padding: 0;
  background: none;
  border: 0;
  font-size: inherit;
}

.markdown-body h1,
.markdown-body h2,
.markdown-body h3,
.markdown-body h4,
.markdown-body h5,
.markdown-body h6 {
  line-height: 1.3;
}

.markdown-body h1 { font-size: 1.7em; }
.markdown-body h2 { font-size: 1.35em; }
.markdown-body h3 { font-size: 1.15em; }

/* code is 85% of its parent, so in a 2em h1 it becomes the boxed monster. */
.markdown-body h1 code,
.markdown-body h2 code,
.markdown-body h3 code,
.markdown-body h4 code {
  font-size: 0.9em;
  font-weight: inherit;
  padding: 0.05em 0.25em;
}

/* github-markdown.css lays tables out as `width: max-content` blocks, which
   in a pane this narrow means everything of interest is off-screen. */
.markdown-body table {
  display: table;
  width: 100%;
  border-collapse: collapse;
  margin: 1rem 0;
  font-size: 0.95em;
}

.markdown-body table th,
.markdown-body table td {
  border: 1px solid var(--color-border-default);
  padding: 0.4rem 0.6rem;
  text-align: left;
  vertical-align: top;
}

.markdown-body table th { background-color: var(--color-canvas-subtle); }

/* A headerless `| | |` table still emits an empty header row; hide it. */
.markdown-body thead:not(:has(th:not(:empty))) { display: none; }

/* Task list checkboxes arrive as bare inputs, with no list class to hang off. */
.markdown-body li > input[type="checkbox"] {
  margin: 0 0.4em 0 0;
  vertical-align: middle;
}

.markdown-body ul,
.markdown-body ol { padding-left: 1.5em; }
.markdown-body li + li { margin-top: 0.25em; }
.markdown-body img { max-width: 100%; }
</style>
CSS

CMARK_ARGS=(
  --sourcepos --unsafe
  -e table -e strikethrough -e autolink -e tasklist -e tagfilter -e footnotes
)

if [[ ${1-} && -r ${1-} ]]; then
  exec "$CMARK" "${CMARK_ARGS[@]}" "$1"
fi

exec "$CMARK" "${CMARK_ARGS[@]}"
